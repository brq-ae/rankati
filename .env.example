# Rankati — configuration template.
#   cp .env.example .env
# Then set a strong POSTGRES_PASSWORD below and run `docker compose up -d`.
# Your real .env holds secrets and is never committed.

# ── Image version ────────────────────────────────────────────────────────────
# Which published image tag the stack runs. Pin this to stay on a known version
# across `docker compose pull`. Defaults to the current release if left unset.
RANKATI_VERSION=0.30.0

# ── Database (the bundled Postgres) ──────────────────────────────────────────
# The bundled `db` service is created with these on its FIRST start.
# POSTGRES_PASSWORD has NO default on purpose — you MUST set a strong one.
# This is the ONLY password to set: the api's connection string is built from these.
POSTGRES_USER=rankati
POSTGRES_PASSWORD=changeme-to-a-strong-password
POSTGRES_DB=rankati

# Optional: override the database connection to point at an EXTERNAL Postgres.
# Leave commented to use the bundled `db` service (the stack derives the URL from the
# POSTGRES_* values above). Uncomment and set only for an external/managed database.
# DATABASE_URL=postgresql://user:password@your-db-host:5432/rankati?schema=public

# ── Web ──────────────────────────────────────────────────────────────────────
# The host port Rankati is published on. Point your browser — or a TLS reverse
# proxy for internet exposure — at this port. The container listens on 8080 inside.
WEB_PORT=12101

# ── Reverse proxy ────────────────────────────────────────────────────────────
# Trust X-Forwarded-* headers from an upstream proxy?
# false = safe default: the app ignores client-supplied forwarded headers.
# Set true ONLY when a trusted TLS proxy (Caddy, nginx, Traefik, Cloudflare
# tunnel) really sits in front — that is also what lets the session cookie be
# marked Secure. Never expose the plain HTTP port to the internet without one.
TRUST_PROXY=false
